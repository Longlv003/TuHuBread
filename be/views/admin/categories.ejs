<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="header-bar">
    <div class="welcome-text">
      <h1>Danh mục toàn hệ thống</h1>
      <p>Danh mục dùng chung cho toàn bộ chi nhánh (hiển thị trong dropdown khi shop thêm sản phẩm)</p>
    </div>
  </div>

  <div class="content-grid">
    <div class="section-card">
      <div class="section-header"><h3>Danh sách danh mục (<%= total %>)</h3></div>
      <div class="table-container">
        <table>
          <thead><tr><th class="col-icon">Icon</th><th class="col-name">Tên danh mục</th><th class="col-status">Trạng thái</th><th class="col-actions">Hành động</th></tr></thead>
          <tbody>
            <% if (categories.length === 0) { %>
              <tr><td colspan="4">
                <div class="empty-state">
                  <div class="empty-state-icon"><i class="fa-solid fa-tags"></i></div>
                  <div class="empty-state-title">Chưa có danh mục nào</div>
                  <div class="empty-state-desc">Tạo danh mục toàn hệ thống để các chi nhánh dùng chung.</div>
                </div>
              </td></tr>
            <% } %>
            <% categories.forEach(cat => { %>
              <tr>
                <td class="col-icon"><img src="<%= cat.category_icon ? cat.category_icon : 'https://placehold.co/50' %>" onerror="this.src='https://placehold.co/50'"></td>
                <td class="col-name"><strong><%= cat.category_name %></strong></td>
                <td class="col-status"><span class="status-badge <%= cat.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= cat.status %></span></td>
                <td class="col-actions">
                  <div class="actions-wrap">
                    <button type="button" class="btn-action" onclick="onEditCategory('<%= cat._id %>', '<%= cat.category_name %>', '<%= cat.status %>', '<%= cat.category_icon %>')">Sửa</button>
                    <button type="button" class="btn-action btn-delete" onclick="onDeleteCategory('<%= cat._id %>')">Xóa</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('partials/pagination', { page, totalPages, baseUrl: '/admin/categories' }) %>
    </div>

    <div>
      <div class="section-card" id="addCard">
        <div class="section-header"><h3>Thêm danh mục mới</h3></div>
        <form id="addCategoryForm" enctype="multipart/form-data">
          <div class="form-group"><label>Tên danh mục *</label><input type="text" id="addCategoryName" required placeholder="Ví dụ: Bánh Ngọt"></div>
          <div class="form-group"><label>Ảnh Icon</label><input type="file" id="addIcon" accept="image/*" onchange="previewImage(this, 'addPreview')"><img id="addPreview" class="preview-box"></div>
          <button type="submit" class="btn-submit">Lưu danh mục</button>
        </form>
      </div>

      <div class="section-card" id="editCard" style="display:none;">
        <div class="section-header"><h3>Cập nhật danh mục</h3></div>
        <form id="editCategoryForm" enctype="multipart/form-data">
          <input type="hidden" id="editCategoryId">
          <div class="form-group"><label>Tên danh mục *</label><input type="text" id="editCategoryName" required></div>
          <div class="form-group"><label>Trạng thái</label>
            <select id="editStatus"><option value="active">Active</option><option value="inactive">Inactive</option></select>
          </div>
          <div class="form-group"><label>Thay đổi Icon</label><input type="file" id="editIcon" accept="image/*" onchange="previewImage(this, 'editPreview')"><img id="editPreview" class="preview-box"></div>
          <button type="submit" class="btn-submit">Lưu</button>
          <button type="button" class="btn-cancel" onclick="cancelEdit()">Hủy bỏ</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function previewImage(input, previewId) {
    const preview = document.getElementById(previewId);
    const file = input.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = e => { preview.src = e.target.result; preview.style.display = "block"; };
      reader.readAsDataURL(file);
    }
  }

  document.getElementById("addCategoryForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData();
    formData.append("categoryName", document.getElementById("addCategoryName").value.trim());
    formData.append("status", "active");
    const iconFile = document.getElementById("addIcon").files[0];
    if (iconFile) formData.append("categoryIcon", iconFile);

    try {
      const response = await fetch("/admin/categories/add", { method: "POST", body: formData });
      const result = await response.json();
      if (result.status === "success") { showToast("Thêm danh mục thành công!", "success"); setTimeout(() => window.location.reload(), 900); }
      else showToast(result.msg || "Thất bại", "error");
    } catch (err) { console.error(err); showToast("Lỗi", "error"); }
  });

  function onEditCategory(id, name, status, iconUrl) {
    document.getElementById("addCard").style.display = "none";
    document.getElementById("editCard").style.display = "block";
    document.getElementById("editCategoryId").value = id;
    document.getElementById("editCategoryName").value = name;
    document.getElementById("editStatus").value = status;
    const preview = document.getElementById("editPreview");
    if (iconUrl && iconUrl !== "null") { preview.src = iconUrl; preview.style.display = "block"; }
  }

  function cancelEdit() {
    document.getElementById("editCard").style.display = "none";
    document.getElementById("addCard").style.display = "block";
  }

  document.getElementById("editCategoryForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = document.getElementById("editCategoryId").value;
    const formData = new FormData();
    formData.append("categoryName", document.getElementById("editCategoryName").value.trim());
    formData.append("status", document.getElementById("editStatus").value);
    const iconFile = document.getElementById("editIcon").files[0];
    if (iconFile) formData.append("categoryIcon", iconFile);

    try {
      const response = await fetch(`/admin/categories/edit/${id}`, { method: "POST", body: formData });
      const result = await response.json();
      if (result.status === "success") { showToast("Cập nhật thành công!", "success"); setTimeout(() => window.location.reload(), 900); }
      else showToast(result.msg || "Thất bại", "error");
    } catch (err) { console.error(err); showToast("Lỗi", "error"); }
  });

  async function onDeleteCategory(id) {
    if (!(await showConfirmDialog({ title: "Xoá danh mục", message: "Xóa danh mục này?", confirmText: "Xoá", danger: true }))) return;
    const response = await fetch(`/admin/categories/delete/${id}`, { method: "POST" });
    const result = await response.json();
    if (result.status === "success") { showToast("Đã xóa!", "success"); setTimeout(() => window.location.reload(), 900); }
    else showToast(result.msg || "Thất bại", "error");
  }
</script>

<%- include('partials/footer') %>
