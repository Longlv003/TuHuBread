<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="realtime-banner" id="alertBanner">
    <span><i class="fa-solid fa-bell fa-bounce"></i> <span id="bannerText">Có đơn hàng mới vừa được đặt!</span></span>
    <button onclick="document.getElementById('alertBanner').style.display='none'" style="background:none; border:none; color:white; cursor:pointer; font-size:16px;">&times;</button>
  </div>

  <div class="header-bar">
    <div class="welcome-text">
      <h1>Xin chào, <%= user.full_name %></h1>
      <p>Bảng điều khiển thông tin hoạt động kinh doanh realtime</p>
    </div>
    <div class="shop-badge">
      <div class="status-dot"></div>
      <span style="font-size: 13px; font-weight: 600; color: var(--success);" id="connectionStatus">Realtime Connected</span>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin-bottom: 40px;">
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Doanh thu hôm nay</h4>
        <h2 id="revenueText"><%= stats.totalRevenue.toLocaleString('vi-VN') %>đ</h2>
        <span class="kpi-trend neutral">Đơn đã hoàn thành &amp; đã thanh toán</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-coins"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Tổng số đơn</h4>
        <h2 id="totalOrdersText"><%= stats.totalOrdersCount %></h2>
        <span class="kpi-trend neutral">Đặt trong hôm nay</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-clipboard-list"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Đơn chờ xử lý</h4>
        <h2 id="pendingText"><%= stats.pendingOrders %></h2>
        <span class="kpi-trend neutral">Chờ xác nhận</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-hourglass-half"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Đang xử lý</h4>
        <h2 id="processingText"><%= stats.processingOrders %></h2>
        <span class="kpi-trend neutral">Đã xác nhận → đang giao</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-truck-fast"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Đơn thành công</h4>
        <h2 id="completedText"><%= stats.completedOrders %></h2>
        <span class="kpi-trend neutral">Hoàn thành hôm nay</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Đơn đã huỷ</h4>
        <h2 id="cancelledText"><%= stats.cancelledOrders %></h2>
        <span class="kpi-trend neutral">Bị huỷ hôm nay</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-circle-xmark"></i></div>
    </div>
  </div>

  <!-- Cảnh báo cần xử lý -->
  <div class="alert-grid" id="alertGrid">
    <%- include('partials/dashboard_alerts', { alerts: stats.alerts }) %>
  </div>

  <!-- Đơn hàng mới nhất -->
  <div class="section-card" style="margin-bottom: 24px;">
    <div class="section-header">
      <h3>Đơn hàng mới nhất</h3>
      <a href="/shop/orders" class="section-link">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Mã đơn hàng</th>
            <th>Khách hàng</th>
            <th>Phương thức</th>
            <th>Thanh toán</th>
            <th>Trạng thái</th>
            <th>Tổng tiền</th>
          </tr>
        </thead>
        <tbody id="ordersTableBody">
          <% if (stats.recentOrders.length === 0) { %>
            <tr><td colspan="6">
              <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-receipt"></i></div>
                <div class="empty-state-title">Chưa có đơn hàng nào</div>
                <div class="empty-state-desc">Đơn hàng mới từ khách hàng sẽ hiển thị ở đây ngay khi phát sinh.</div>
              </div>
            </td></tr>
          <% } %>
          <% stats.recentOrders.forEach(order => { %>
            <tr>
              <td><strong>#<%= order.order_code %></strong></td>
              <td><%= order.user_id ? order.user_id.full_name : 'N/A' %></td>
              <td><%= order.payment_method.toUpperCase() %></td>
              <td>
                <span class="status-badge <%= order.payment_status === 'paid' ? 'status-completed' : 'status-pending' %>">
                  <%= paymentStatusLabels[order.payment_status] || order.payment_status %>
                </span>
              </td>
              <td>
                <span class="status-badge <%= order.order_status === 'completed' ? 'status-completed' : (order.order_status === 'cancelled' ? 'status-danger' : 'status-processing') %>">
                  <%= orderStatusLabels[order.order_status] || order.order_status %>
                </span>
              </td>
              <td><%= order.total_amount.toLocaleString('vi-VN') %>đ</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div id="dashboardPagination">
      <%- include('partials/pagination', { page: stats.page, totalPages: stats.totalPages, baseUrl: '/shop/dashboard' }) %>
    </div>
  </div>

  <!-- Sản phẩm bán chạy hôm nay -->
  <div class="section-card">
    <div class="section-header">
      <h3>Sản phẩm bán chạy hôm nay</h3>
      <a href="/shop/reports" class="section-link">Báo cáo chi tiết <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="table-container" id="topProductsToday">
      <%- include('partials/dashboard_top_products', { topProducts: stats.topProductsToday }) %>
    </div>
  </div>
</div>

<script>
  const ORDER_STATUS_LABELS_CLIENT = <%- JSON.stringify(orderStatusLabels) %>;

  // Page-specific socket events
  function onSocketConnected(socket) {
    document.getElementById("connectionStatus").innerText = "Realtime Active";
    document.getElementById("connectionStatus").style.color = "var(--success)";

    socket.on("connect_error", (err) => {
      document.getElementById("connectionStatus").innerText = "Connection Failed";
      document.getElementById("connectionStatus").style.color = "var(--danger)";
    });

    socket.on("new_order", (order) => {
      showRealtimeAlert(`Có đơn hàng mới #${order.order_code} vừa được tạo!`);
      playAlertSound();
      refreshDashboardData();
    });

    socket.on("order_updated", (order) => {
      const label = ORDER_STATUS_LABELS_CLIENT[order.order_status] || order.order_status;
      if (order.order_status === "cancelled") {
        showRealtimeAlert(`Đơn hàng #${order.order_code} vừa bị hủy!`);
        playAlertSound();
      } else {
        showRealtimeAlert(`Đơn hàng #${order.order_code} đã chuyển sang trạng thái: ${label}`);
      }
      refreshDashboardData();
    });

    socket.on("dashboard_updated", () => {
      refreshDashboardData();
    });
  }

  function showRealtimeAlert(text) {
    const banner = document.getElementById("alertBanner");
    document.getElementById("bannerText").innerText = text;
    banner.style.display = "flex";
    setTimeout(() => {
      banner.style.display = "none";
    }, 12000);
  }

  async function refreshDashboardData() {
    try {
      const response = await fetch(window.location.href);
      const text = await response.text();

      const parser = new DOMParser();
      const doc = parser.parseFromString(text, 'text/html');

      // Đồng bộ mọi khối phụ thuộc dữ liệu — thiếu ô nào thì ô đó đứng yên
      // với số cũ cho tới lần tải lại trang, dễ khiến chủ shop hiểu nhầm.
      const syncIds = [
        "revenueText", "totalOrdersText", "pendingText", "processingText",
        "completedText", "cancelledText",
        "alertGrid", "ordersTableBody", "dashboardPagination", "topProductsToday",
      ];
      for (const id of syncIds) {
        const fresh = doc.getElementById(id);
        const current = document.getElementById(id);
        if (fresh && current) current.innerHTML = fresh.innerHTML;
      }
    } catch (err) {
      console.error("Failed to refresh dashboard:", err);
    }
  }
</script>

<%- include('partials/footer') %>
