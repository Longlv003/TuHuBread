<%- include('partials/header') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="header-bar">
    <div class="welcome-text">
      <h1>Cài đặt cửa hàng</h1>
      <p>Quản lý thông tin, giờ hoạt động và hình ảnh cửa hàng</p>
    </div>
  </div>

  <div class="content-grid">
    <div class="section-card">
      <div class="section-header"><h3>Thông tin cửa hàng</h3></div>
      <form id="settingsForm">
        <div class="form-group"><label>Tên cửa hàng *</label><input type="text" name="shopName" required value="<%= shop.shop_name %>"></div>
        <div class="form-group"><label>Số điện thoại *</label><input type="text" name="phoneNumber" required value="<%= shop.phone_number %>"></div>
        <div class="form-group"><label>Địa chỉ *</label><textarea name="address" rows="2" required><%= shop.address %></textarea></div>
        <div class="content-grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="form-group"><label>Giờ mở cửa</label><input type="time" name="openTime" value="<%= shop.open_time || '' %>"></div>
          <div class="form-group"><label>Giờ đóng cửa</label><input type="time" name="closeTime" value="<%= shop.close_time || '' %>"></div>
        </div>
        <div class="form-group">
          <label>Vị trí cửa hàng trên bản đồ (bấm vào bản đồ để ghim lại vị trí mới)</label>
          <div id="settingsMap" style="height: 250px; border-radius: 14px; border: 1px solid var(--glass-border); z-index: 5;"></div>
          <input type="hidden" name="latitude" id="shopLatitude">
          <input type="hidden" name="longitude" id="shopLongitude">
        </div>
        <button type="submit" class="btn-submit" style="width:auto; padding: 12px 24px;">Lưu thay đổi</button>
      </form>

      <hr style="border: none; border-top: 1px solid var(--glass-border); margin: 24px 0;">

      <div style="display:flex; align-items:center; justify-content:space-between;">
        <div>
          <strong>Trạng thái hoạt động</strong>
          <p style="color: var(--text-muted); font-size: 13px; margin-top: 4px;">Bật/tắt để hiện shop đang mở cửa cho khách hàng</p>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" id="isOpenToggle" <%= shop.is_open ? 'checked' : '' %>>
          <span class="toggle-slider"></span>
        </label>
      </div>

      <hr style="border: none; border-top: 1px solid var(--glass-border); margin: 24px 0;">

      <div style="font-size: 13px; color: var(--text-muted); display:flex; flex-direction:column; gap:6px;">
        <div>Slug: <strong style="color:var(--text);"><%= shop.shop_slug %></strong></div>
        <div>Đánh giá trung bình: <strong style="color:var(--text);"><%= shop.rating_average %> ⭐ (<%= shop.total_reviews %> đánh giá)</strong></div>
        <div>Trạng thái duyệt (do quản trị hệ thống quản lý): <strong style="color:var(--text);"><%= shop.status %></strong></div>
      </div>
    </div>

    <div class="section-card">
      <div class="section-header"><h3>Banner cửa hàng</h3></div>
      <img id="bannerPreview" src="<%= shop.banner ? shop.banner : 'https://placehold.co/400x200' %>" onerror="this.src='https://placehold.co/400x200'" style="width:100%; border-radius:12px; object-fit:cover; margin-bottom:16px; aspect-ratio: 2/1;">
      <div class="form-group">
        <label>Thay đổi banner</label>
        <input type="file" id="bannerInput" accept="image/*">
      </div>
      <button type="button" class="btn-submit" onclick="uploadBanner()">Tải lên banner</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Bản đồ chọn vị trí cửa hàng — khởi tạo tại vị trí đã lưu, chủ shop bấm vào
  // bản đồ để ghim lại vị trí mới trước khi bấm "Lưu thay đổi".
  (function initShopMap() {
    const hasSavedLocation = <%= shop.location && shop.location.coordinates ? 'true' : 'false' %>;
    const savedCoords = <%- JSON.stringify(shop.location && shop.location.coordinates ? shop.location.coordinates : [108.2201, 16.0612]) %>;
    let lat = savedCoords[1];
    let lng = savedCoords[0];
    let hasPinnedNewLocation = false;
    document.getElementById("shopLatitude").value = lat;
    document.getElementById("shopLongitude").value = lng;

    const map = L.map('settingsMap').setView([lat, lng], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);
    const marker = L.marker([lat, lng]).addTo(map);

    // Bản đồ nằm trong layout sidebar dùng web font tải bất đồng bộ — nếu
    // Leaflet khởi tạo trước khi layout ổn định, nó lưu sai kích thước
    // khung bản đồ, khiến toạ độ tính từ vị trí bấm bị lệch. Tính lại kích
    // thước sau khi trang và font đã tải xong để bấm chọn luôn đúng vị trí.
    function refreshMapSize() {
      map.invalidateSize();
    }
    window.addEventListener('load', refreshMapSize);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(refreshMapSize);
    }

    map.on('click', async function (e) {
      lat = e.latlng.lat;
      lng = e.latlng.lng;
      hasPinnedNewLocation = true;
      marker.setLatLng(e.latlng);
      document.getElementById("shopLatitude").value = lat;
      document.getElementById("shopLongitude").value = lng;

      // Dịch ngược toạ độ ra địa chỉ và điền thẳng vào ô "Địa chỉ" — nếu
      // không làm bước này, ô địa chỉ vẫn giữ nguyên giá trị cũ dù đã ghim vị
      // trí mới, khiến lưu xong tải lại vẫn thấy địa chỉ cũ.
      const addressField = document.querySelector('textarea[name="address"]');
      try {
        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=vi`);
        const data = await response.json();
        if (data && data.display_name && addressField) {
          addressField.value = data.display_name;
        }
      } catch (err) {
        console.error("Reverse geocoding failed:", err);
      }
    });

    // Chỉ coi là "đã có vị trí hợp lệ để gửi lên" nếu shop từng lưu vị trí
    // trước đó, hoặc chủ shop vừa bấm ghim mới — tránh việc chỉ sửa số điện
    // thoại/giờ mở cửa mà vô tình ghi đè vị trí thành toạ độ mặc định.
    window.__shopMapHasPinned = () => hasSavedLocation || hasPinnedNewLocation;
  })();

  document.getElementById("settingsForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    if (!window.__shopMapHasPinned()) {
      delete body.latitude;
      delete body.longitude;
    }
    try {
      const response = await fetch("/shop/settings/update", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (result.status === "success") showToast("Cập nhật thành công!", "success");
      else showToast(result.msg || "Thất bại", "error");
    } catch (err) { console.error(err); showToast("Lỗi", "error"); }
  });

  document.getElementById("isOpenToggle").addEventListener("change", async (e) => {
    const isOpen = e.target.checked;
    try {
      const response = await fetch("/shop/settings/toggle-open", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ isOpen })
      });
      const result = await response.json();
      if (result.status !== "success") {
        showToast(result.msg || "Thất bại", "error");
        e.target.checked = !isOpen;
      }
    } catch (err) {
      console.error(err);
      e.target.checked = !isOpen;
    }
  });

  async function uploadBanner() {
    const file = document.getElementById("bannerInput").files[0];
    if (!file) { showToast("Vui lòng chọn ảnh banner", "error"); return; }

    const formData = new FormData();
    formData.append("banner", file);

    try {
      const response = await fetch("/shop/settings/banner", { method: "POST", body: formData });
      const result = await response.json();
      if (result.status === "success") {
        document.getElementById("bannerPreview").src = result.bannerUrl;
        showToast("Cập nhật banner thành công!", "success");
      } else {
        showToast(result.msg || "Tải lên thất bại", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Lỗi khi tải banner!", "error");
    }
  }
</script>

<%- include('partials/footer') %>
