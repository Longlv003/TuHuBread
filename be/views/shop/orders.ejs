<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="realtime-banner" id="alertBanner">
    <span><i class="fa-solid fa-bell fa-bounce"></i> <span id="bannerText">Có đơn hàng mới vừa được đặt!</span></span>
    <button onclick="document.getElementById('alertBanner').style.display='none'" style="background:none; border:none; color:white; cursor:pointer; font-size:16px;">&times;</button>
  </div>

  <div class="header-bar">
    <div class="welcome-text">
      <h1>Quản lý đơn hàng</h1>
      <p>Theo dõi và xử lý đơn hàng của cửa hàng theo thời gian thực</p>
    </div>
  </div>

  <form id="filterForm" method="GET" action="/shop/orders">
    <div class="search-filter-bar">
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="search" value="<%= search %>" placeholder="Tìm theo mã đơn hoặc tên/SĐT khách hàng...">
      </div>
      <div class="filter-box">
        <select name="status" onchange="document.getElementById('filterForm').submit()">
          <option value="all" <%= status === 'all' ? 'selected' : '' %>>Tất cả trạng thái</option>
          <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Chờ xác nhận</option>
          <option value="confirmed" <%= status === 'confirmed' ? 'selected' : '' %>>Đã xác nhận</option>
          <option value="preparing" <%= status === 'preparing' ? 'selected' : '' %>>Đang chuẩn bị</option>
          <option value="delivering" <%= status === 'delivering' ? 'selected' : '' %>>Đang giao</option>
          <option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
          <option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
        </select>
      </div>
      <button type="submit" class="btn-action">Lọc</button>
    </div>
  </form>

  <div class="section-card">
    <div class="section-header">
      <h3>Danh sách đơn hàng (<%= total %>)</h3>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Mã đơn hàng</th>
            <th>Khách hàng</th>
            <th>Phương thức</th>
            <th>Thanh toán</th>
            <th>Trạng thái</th>
            <th>Tổng tiền</th>
            <th>Thời gian</th>
            <th class="col-actions">Hành động</th>
          </tr>
        </thead>
        <tbody id="ordersTableBody">
          <% if (orders.length === 0) { %>
            <tr><td colspan="8">
              <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-receipt"></i></div>
                <div class="empty-state-title">Chưa có đơn hàng nào</div>
                <div class="empty-state-desc">Đơn hàng mới từ khách hàng sẽ hiển thị ở đây ngay khi phát sinh.</div>
              </div>
            </td></tr>
          <% } %>
          <% orders.forEach(order => { %>
            <tr>
              <td><strong>#<%= order.order_code %></strong></td>
              <td><%= order.user_id ? order.user_id.full_name : 'N/A' %></td>
              <td><%= order.payment_method.toUpperCase() %></td>
              <td>
                <span class="status-badge <%= order.payment_status === 'paid' ? 'status-completed' : (order.payment_status === 'refunded' ? 'status-danger' : 'status-pending') %>">
                  <%= paymentStatusLabels[order.payment_status] || order.payment_status %>
                </span>
              </td>
              <td>
                <span class="status-badge <%= order.order_status === 'completed' ? 'status-completed' : (order.order_status === 'cancelled' ? 'status-danger' : (order.order_status === 'pending' ? 'status-pending' : 'status-processing')) %>">
                  <%= orderStatusLabels[order.order_status] || order.order_status %>
                </span>
              </td>
              <td><%= order.total_amount.toLocaleString('vi-VN') %>đ</td>
              <td><%= new Date(order.createdAt).toLocaleString('vi-VN') %></td>
              <td class="col-actions">
                <div class="actions-wrap">
                  <a href="/shop/orders/<%= order._id %>" class="btn-action">Chi tiết</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination', {
      page, totalPages, baseUrl: '/shop/orders',
      extraQuery: 'search=' + encodeURIComponent(search) + '&status=' + status
    }) %>
  </div>
</div>

<script>
  const ORDER_STATUS_LABELS_CLIENT = <%- JSON.stringify(orderStatusLabels) %>;

  function onSocketConnected(socket) {
    socket.on("new_order", (order) => {
      showRealtimeAlert(`Có đơn hàng mới #${order.order_code} vừa được tạo!`);
      playAlertSound();
      setTimeout(() => window.location.reload(), 1500);
    });

    socket.on("order_updated", (order) => {
      const label = ORDER_STATUS_LABELS_CLIENT[order.order_status] || order.order_status;
      if (order.order_status === "cancelled") {
        showRealtimeAlert(`Đơn hàng #${order.order_code} vừa bị hủy!`);
        playAlertSound();
        setTimeout(() => window.location.reload(), 1500);
      } else {
        showRealtimeAlert(`Đơn hàng #${order.order_code} đã chuyển sang trạng thái: ${label}`);
      }
    });
  }

  function showRealtimeAlert(text) {
    const banner = document.getElementById("alertBanner");
    document.getElementById("bannerText").innerText = text;
    banner.style.display = "flex";
    setTimeout(() => { banner.style.display = "none"; }, 12000);
  }
</script>

<%- include('partials/footer') %>
