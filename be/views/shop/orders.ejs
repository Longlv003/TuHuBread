<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="realtime-banner" id="alertBanner">
    <span><i class="fa-solid fa-bell fa-bounce"></i> <span id="bannerText">Có đơn hàng mới vừa được đặt!</span></span>
    <button onclick="document.getElementById('alertBanner').style.display='none'" style="background:none; border:none; color:white; cursor:pointer; font-size:16px;">&times;</button>
  </div>

  <div class="header-bar">
    <div class="welcome-text">
      <h1>Quản lý đơn hàng</h1>
      <p>Theo dõi và xử lý đơn hàng của cửa hàng theo thời gian thực</p>
    </div>
  </div>

  <div class="search-filter-bar">
    <div class="search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="orderSearchInput" placeholder="Tìm theo mã đơn hoặc tên khách hàng...">
    </div>
    <div class="filter-box">
      <select id="orderFilterStatus">
        <option value="all">Tất cả trạng thái</option>
        <option value="pending">Chờ xác nhận</option>
        <option value="confirmed">Đã xác nhận</option>
        <option value="preparing">Đang chuẩn bị</option>
        <option value="delivering">Đang giao</option>
        <option value="completed">Hoàn thành</option>
        <option value="cancelled">Đã hủy</option>
      </select>
    </div>
  </div>

  <div class="section-card">
    <div class="section-header">
      <h3>Danh sách đơn hàng (<%= total %>)</h3>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Mã đơn hàng</th>
            <th>Khách hàng</th>
            <th>Phương thức</th>
            <th>Thanh toán</th>
            <th>Trạng thái</th>
            <th>Tổng tiền</th>
            <th>Thời gian</th>
            <th class="col-actions">Hành động</th>
          </tr>
        </thead>
        <tbody id="ordersTableBody">
          <% if (orders.length === 0) { %>
            <tr><td colspan="8">
              <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-receipt"></i></div>
                <div class="empty-state-title">Chưa có đơn hàng nào</div>
                <div class="empty-state-desc">Đơn hàng mới từ khách hàng sẽ hiển thị ở đây ngay khi phát sinh.</div>
              </div>
            </td></tr>
          <% } %>
          <% orders.forEach(order => { %>
            <tr data-code="<%= order.order_code.toLowerCase() %>" data-customer="<%= order.user_id ? order.user_id.full_name.toLowerCase() : '' %>" data-status="<%= order.order_status %>">
              <td><strong>#<%= order.order_code %></strong></td>
              <td><%= order.user_id ? order.user_id.full_name : 'N/A' %></td>
              <td><%= order.payment_method.toUpperCase() %></td>
              <td>
                <span class="status-badge <%= order.payment_status === 'paid' ? 'status-completed' : (order.payment_status === 'refunded' ? 'status-danger' : 'status-pending') %>">
                  <%= paymentStatusLabels[order.payment_status] || order.payment_status %>
                </span>
              </td>
              <td>
                <span class="status-badge <%= order.order_status === 'completed' ? 'status-completed' : (order.order_status === 'cancelled' ? 'status-danger' : (order.order_status === 'pending' ? 'status-pending' : 'status-processing')) %>">
                  <%= orderStatusLabels[order.order_status] || order.order_status %>
                </span>
              </td>
              <td><%= order.total_amount.toLocaleString('vi-VN') %>đ</td>
              <td><%= new Date(order.createdAt).toLocaleString('vi-VN') %></td>
              <td class="col-actions">
                <div class="actions-wrap">
                  <a href="/shop/orders/<%= order._id %>" class="btn-action">Chi tiết</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination', { page, totalPages, baseUrl: '/shop/orders' }) %>
  </div>
</div>

<script>
  const ORDER_STATUS_LABELS_CLIENT = <%- JSON.stringify(orderStatusLabels) %>;

  function onSocketConnected(socket) {
    socket.on("new_order", (order) => {
      showRealtimeAlert(`Có đơn hàng mới #${order.order_code} vừa được tạo!`);
      playAlertSound();
      setTimeout(() => window.location.reload(), 1500);
    });

    socket.on("order_updated", (order) => {
      const label = ORDER_STATUS_LABELS_CLIENT[order.order_status] || order.order_status;
      if (order.order_status === "cancelled") {
        showRealtimeAlert(`Đơn hàng #${order.order_code} vừa bị hủy!`);
        playAlertSound();
        setTimeout(() => window.location.reload(), 1500);
      } else {
        showRealtimeAlert(`Đơn hàng #${order.order_code} đã chuyển sang trạng thái: ${label}`);
      }
    });
  }

  function showRealtimeAlert(text) {
    const banner = document.getElementById("alertBanner");
    document.getElementById("bannerText").innerText = text;
    banner.style.display = "flex";
    setTimeout(() => { banner.style.display = "none"; }, 12000);
  }

  // Client-side search and filter
  const orderSearchInput = document.getElementById("orderSearchInput");
  const orderFilterStatus = document.getElementById("orderFilterStatus");

  function filterOrders() {
    const query = orderSearchInput.value.toLowerCase().trim();
    const statusFilter = orderFilterStatus.value;
    const rows = document.querySelectorAll("#ordersTableBody tr");

    rows.forEach(row => {
      const code = row.getAttribute("data-code");
      const customer = row.getAttribute("data-customer");
      const status = row.getAttribute("data-status");

      const matchesSearch = code.includes(query) || customer.includes(query);
      const matchesStatus = (statusFilter === "all") || (status === statusFilter);

      row.style.display = (matchesSearch && matchesStatus) ? "" : "none";
    });
  }

  orderSearchInput.addEventListener("input", filterOrders);
  orderFilterStatus.addEventListener("change", filterOrders);
</script>

<%- include('partials/footer') %>
