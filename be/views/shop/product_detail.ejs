<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="header-bar">
    <div class="welcome-text">
      <h1><%= product.product_name %></h1>
      <p>Quản lý biến thể, topping của sản phẩm</p>
    </div>
    <a href="/shop/products" class="btn-action"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a>
  </div>

  <!-- Product basic info -->
  <div class="section-card" style="margin-bottom: 24px;">
    <div class="section-header"><h3>Thông tin sản phẩm</h3></div>
    <form id="editProductForm">
      <div class="content-grid">
        <div class="form-group">
          <label for="editProductName">Tên sản phẩm *</label>
          <input type="text" id="editProductName" name="productName" required value="<%= product.product_name %>">
        </div>
        <div class="form-group">
          <label for="editStatus">Trạng thái</label>
          <select id="editStatus" name="status">
            <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Đang bán</option>
            <option value="inactive" <%= product.status !== 'active' ? 'selected' : '' %>>Ngừng bán</option>
          </select>
        </div>
        <div class="form-group">
          <label for="editGlobalCategoryId">Danh mục toàn hệ thống</label>
          <%
            const currentCategory = product.global_category_id;
            const currentCategoryId = currentCategory ? String(currentCategory._id || currentCategory) : null;
            const isCurrentCategoryActive = currentCategoryId && globalCategories.some(c => String(c._id) === currentCategoryId);
          %>
          <select id="editGlobalCategoryId" name="globalCategoryId">
            <% if (currentCategoryId && !isCurrentCategoryActive) { %>
              <!-- Danh mục hiện tại của sản phẩm đã bị ngừng hoạt động — giữ nguyên lựa chọn
                   này để tránh tự động gán nhầm sang danh mục khác khi lưu các trường khác. -->
              <option value="<%= currentCategoryId %>" selected>
                <%= currentCategory && currentCategory.category_name ? currentCategory.category_name : 'Danh mục hiện tại' %> (Ngừng hoạt động)
              </option>
            <% } %>
            <% globalCategories.forEach(c => { %>
              <option value="<%= c._id %>" <%= currentCategoryId === String(c._id) ? 'selected' : '' %>><%= c.category_name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="editPrepTime">Thời gian chuẩn bị (phút)</label>
          <input type="number" id="editPrepTime" name="prepTimeMinutes" min="0" value="<%= product.preparation_time_minutes %>">
        </div>
        <div class="form-group">
          <label for="editDescription">Mô tả</label>
          <textarea id="editDescription" name="description" rows="1"><%= product.description || '' %></textarea>
        </div>
        <div class="form-group" style="grid-column: 1 / -1;">
          <label for="editStorageNote">Ghi chú bảo quản (hiển thị cho khách)</label>
          <textarea id="editStorageNote" name="storageNote" rows="2" placeholder="Ví dụ: Làm khi có đơn, dùng ngay trong 2h. Bảo quản nơi khô ráo, thoáng mát."><%= product.storage_note || '' %></textarea>
        </div>
      </div>
      <button type="submit" class="btn-submit" style="width:auto; padding: 12px 24px;">Lưu thông tin sản phẩm</button>
    </form>
  </div>

  <!-- Tabs -->
  <div class="tab-nav">
    <button type="button" class="tab-btn active" data-tab="variants">Biến thể</button>
    <button type="button" class="tab-btn" data-tab="options">Topping</button>
  </div>

  <!-- TAB: Variants -->
  <div class="tab-panel active" id="tab-variants">
    <div class="section-card">
      <div class="section-header">
        <h3>Danh sách biến thể</h3>
        <button type="button" class="btn-primary-action" onclick="openVariantModal()">
          <i class="fa-solid fa-plus"></i>
          Thêm biến thể
        </button>
      </div>
      <div class="table-container">
        <table>
          <thead><tr><th>Tên</th><th>Giá</th><th>Giá KM</th><th>HSD</th><th>Trạng thái</th><th class="col-actions">Hành động</th></tr></thead>
          <tbody>
              <% variants.forEach(v => { %>
                <tr>
                  <td><strong><%= v.variant_name %></strong></td>
                  <td><%= v.price.toLocaleString('vi-VN') %>đ</td>
                  <td><%= v.sale_price ? v.sale_price.toLocaleString('vi-VN') + 'đ' : '-' %></td>
                  <td><%= variantExpiry[v._id] ? new Date(variantExpiry[v._id]).toLocaleDateString('vi-VN') : '-' %></td>
                  <td><span class="status-badge <%= v.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= v.status %></span></td>
                  <td class="col-actions">
                    <div class="actions-wrap">
                      <button type="button" class="btn-action" onclick='openVariantModal(<%= JSON.stringify(v) %>)'>Sửa</button>
                      <button type="button" class="btn-action btn-delete" onclick="onDeleteVariant('<%= v._id %>')">Xóa</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (variants.length === 0) { %>
                <tr><td colspan="6">
                  <div class="empty-state">
                    <div class="empty-state-icon"><i class="fa-solid fa-layer-group"></i></div>
                    <div class="empty-state-title">Chưa có biến thể nào</div>
                    <div class="empty-state-desc">Bấm "Thêm biến thể" để tạo size và giá cho sản phẩm.</div>
                  </div>
                </td></tr>
              <% } %>
          </tbody>
        </table>
        </div>
    </div>
  </div>

  <!-- TAB: Options (Topping) -->
  <div class="tab-panel" id="tab-options">
    <div class="section-card">
      <div class="section-header">
        <h3>Danh sách topping</h3>
        <button type="button" class="btn-primary-action" onclick="openOptionModal()">
          <i class="fa-solid fa-plus"></i>
          Thêm topping
        </button>
      </div>
      <div class="table-container">
        <table>
          <thead><tr><th>Tên topping</th><th>Giá thêm</th><th>Trạng thái</th><th class="col-actions">Hành động</th></tr></thead>
          <tbody>
              <% options.forEach(o => { %>
                <tr>
                  <td><strong><%= o.option_name %></strong></td>
                  <td>+<%= o.extra_price.toLocaleString('vi-VN') %>đ</td>
                  <td><span class="status-badge <%= o.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= o.status %></span></td>
                  <td class="col-actions">
                    <div class="actions-wrap">
                      <button type="button" class="btn-action" onclick='openOptionModal(<%= JSON.stringify(o) %>)'>Sửa</button>
                      <button type="button" class="btn-action btn-delete" onclick="onDeleteOption('<%= o._id %>')">Xóa</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (options.length === 0) { %>
                <tr><td colspan="4">
                  <div class="empty-state">
                    <div class="empty-state-icon"><i class="fa-solid fa-plus-minus"></i></div>
                    <div class="empty-state-title">Chưa có topping nào</div>
                    <div class="empty-state-desc">Bấm "Thêm topping" để khách chọn thêm khi đặt món.</div>
                  </div>
                </td></tr>
              <% } %>
          </tbody>
        </table>
        </div>
    </div>
  </div>

</div>

<!-- Dialog thêm/sửa biến thể — dùng chung 1 form, phân biệt bằng variantId ẩn -->
<div class="product-modal-overlay" id="variantModalOverlay">
  <div class="product-modal-card">
    <div class="product-modal-header">
      <h3 id="variantModalTitle">Thêm biến thể</h3>
      <button type="button" class="product-modal-close" onclick="closeVariantModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form id="variantForm" enctype="multipart/form-data">
      <input type="hidden" id="variantId">
      <div class="product-modal-body">
        <div class="form-group">
          <label for="variantName">Tên biến thể *</label>
          <input type="text" id="variantName" name="variantName" required placeholder="Ví dụ: Size L">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="variantPrice">Giá bán *</label>
            <input type="number" id="variantPrice" name="price" required min="0" placeholder="20000">
          </div>
          <div class="form-group">
            <label for="variantSalePrice">Giá khuyến mãi</label>
            <input type="number" id="variantSalePrice" name="salePrice" min="0">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="variantExpiredAt">Hạn sử dụng</label>
            <input type="date" id="variantExpiredAt" name="expiredAt">
          </div>
          <div class="form-group">
            <label for="variantStatus">Trạng thái</label>
            <select id="variantStatus" name="status">
              <option value="active">Đang bán</option>
              <option value="inactive">Ngừng bán</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="variantImage">Ảnh</label>
          <input type="file" id="variantImage" name="variantImage" accept="image/*" onchange="previewVariantImage(this)">
        </div>
        <img id="variantPreview" class="preview-box">
      </div>
      <div class="product-modal-footer">
        <button type="button" class="btn-cancel" onclick="closeVariantModal()">Hủy</button>
        <button type="submit" class="btn-submit" id="variantSubmitBtn">Lưu biến thể</button>
      </div>
    </form>
  </div>
</div>

<!-- Dialog thêm/sửa topping -->
<div class="product-modal-overlay" id="optionModalOverlay">
  <div class="product-modal-card" style="max-width: 480px;">
    <div class="product-modal-header">
      <h3 id="optionModalTitle">Thêm topping</h3>
      <button type="button" class="product-modal-close" onclick="closeOptionModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form id="optionForm">
      <input type="hidden" id="optionId">
      <div class="product-modal-body">
        <div class="form-group">
          <label for="optionName">Tên topping *</label>
          <input type="text" id="optionName" name="optionName" required placeholder="Ví dụ: Thêm trứng">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="optionExtraPrice">Giá thêm</label>
            <input type="number" id="optionExtraPrice" name="extraPrice" min="0" value="0">
          </div>
          <div class="form-group">
            <label for="optionStatus">Trạng thái</label>
            <select id="optionStatus" name="status">
              <option value="active">Đang bán</option>
              <option value="inactive">Ngừng bán</option>
            </select>
          </div>
        </div>
      </div>
      <div class="product-modal-footer">
        <button type="button" class="btn-cancel" onclick="closeOptionModal()">Hủy</button>
        <button type="submit" class="btn-submit" id="optionSubmitBtn">Lưu topping</button>
      </div>
    </form>
  </div>
</div>

<script>
  const PRODUCT_ID = "<%= product._id %>";

  // Tab switching
  document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
      btn.classList.add("active");
      document.getElementById(`tab-${btn.dataset.tab}`).classList.add("active");
    });
  });

  // Edit product basic info
  document.getElementById("editProductForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    try {
      const response = await fetch(`/shop/products/edit/${PRODUCT_ID}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (result.status === "success") {
        showToast("Cập nhật sản phẩm thành công!", "success");
        setTimeout(() => window.location.reload(), 900);
      } else {
        showToast(result.msg || "Cập nhật thất bại", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Lỗi khi cập nhật sản phẩm!", "error");
    }
  });

  // ---- Generic submit helper (multipart) ----
  async function submitForm(url, formEl) {
    const formData = new FormData(formEl);
    const response = await fetch(url, { method: "POST", body: formData });
    return response.json();
  }

  // ---- Dialog dùng chung cho cả thêm & sửa ----
  //
  // Trước đây form thêm và form sửa là 2 card cạnh bảng, bấm "Sửa" thì card
  // thêm bị ẩn đi — nên đang sửa thì không còn nút/ô nào để thêm mới. Giờ cả
  // hai đi qua cùng 1 dialog: không truyền dữ liệu là "thêm", có dữ liệu là
  // "sửa" (id nằm trong input ẩn, quyết định gọi endpoint nào lúc submit).
  function openModal(overlay) {
    overlay.classList.add("show");
    document.body.style.overflow = "hidden";
  }
  function closeModal(overlay) {
    overlay.classList.remove("show");
    document.body.style.overflow = "";
  }

  // ---- VARIANTS ----
  const variantModalOverlay = document.getElementById("variantModalOverlay");
  const variantForm = document.getElementById("variantForm");
  const variantPreview = document.getElementById("variantPreview");

  function previewVariantImage(input) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      variantPreview.src = e.target.result;
      variantPreview.style.display = "block";
    };
    reader.readAsDataURL(file);
  }

  function openVariantModal(v) {
    variantForm.reset();
    variantPreview.style.display = "none";
    variantPreview.removeAttribute("src");

    if (v) {
      document.getElementById("variantModalTitle").innerText = "Sửa biến thể";
      document.getElementById("variantSubmitBtn").innerText = "Lưu thay đổi";
      document.getElementById("variantId").value = v._id;
      document.getElementById("variantName").value = v.variant_name;
      document.getElementById("variantPrice").value = v.price;
      document.getElementById("variantSalePrice").value = v.sale_price || "";
      // Hạn sử dụng để trống: chỉ điền khi vừa nhập thêm hàng, vì mỗi lần điền
      // là tạo một lô mới chứ không sửa hạn của lô cũ.
      document.getElementById("variantExpiredAt").value = "";
      // "out_of_stock" là trạng thái cũ (từ thời còn quản lý tồn kho) — select
      // giờ chỉ còn active/inactive, quy về "inactive" để không bị bỏ trống lựa chọn.
      document.getElementById("variantStatus").value = v.status === "active" ? "active" : "inactive";
      if (v.image) {
        variantPreview.src = v.image;
        variantPreview.style.display = "block";
      }
    } else {
      document.getElementById("variantModalTitle").innerText = "Thêm biến thể";
      document.getElementById("variantSubmitBtn").innerText = "Lưu biến thể";
      document.getElementById("variantId").value = "";
      document.getElementById("variantStatus").value = "active";
    }

    openModal(variantModalOverlay);
  }

  function closeVariantModal() {
    closeModal(variantModalOverlay);
  }

  variantModalOverlay.addEventListener("click", (e) => {
    if (e.target === variantModalOverlay) closeVariantModal();
  });

  variantForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = document.getElementById("variantId").value;
    const url = id
      ? `/shop/products/${PRODUCT_ID}/variants/edit/${id}`
      : `/shop/products/${PRODUCT_ID}/variants/add`;
    const submitBtn = document.getElementById("variantSubmitBtn");
    const originalLabel = submitBtn.innerText;
    submitBtn.disabled = true;
    submitBtn.innerText = "Đang lưu...";
    try {
      const result = await submitForm(url, variantForm);
      if (result.status === "success") {
        showToast(id ? "Cập nhật biến thể thành công!" : "Thêm biến thể thành công!", "success");
        closeVariantModal();
        setTimeout(() => window.location.reload(), 900);
      } else {
        showToast(result.msg || "Thất bại", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Lỗi", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = originalLabel;
    }
  });

  async function onDeleteVariant(id) {
    if (!(await showConfirmDialog({ title: "Xoá biến thể", message: "Xóa biến thể này?", confirmText: "Xoá", danger: true }))) return;
    const response = await fetch(`/shop/products/${PRODUCT_ID}/variants/delete/${id}`, { method: "POST" });
    const result = await response.json();
    if (result.status === "success") { showToast("Đã xóa!", "success"); setTimeout(() => window.location.reload(), 900); }
    else showToast(result.msg || "Thất bại", "error");
  }

  // ---- OPTIONS (Topping) ----
  const optionModalOverlay = document.getElementById("optionModalOverlay");
  const optionForm = document.getElementById("optionForm");

  function openOptionModal(o) {
    optionForm.reset();

    if (o) {
      document.getElementById("optionModalTitle").innerText = "Sửa topping";
      document.getElementById("optionSubmitBtn").innerText = "Lưu thay đổi";
      document.getElementById("optionId").value = o._id;
      document.getElementById("optionName").value = o.option_name;
      document.getElementById("optionExtraPrice").value = o.extra_price;
      document.getElementById("optionStatus").value = o.status;
    } else {
      document.getElementById("optionModalTitle").innerText = "Thêm topping";
      document.getElementById("optionSubmitBtn").innerText = "Lưu topping";
      document.getElementById("optionId").value = "";
      document.getElementById("optionStatus").value = "active";
    }

    openModal(optionModalOverlay);
  }

  function closeOptionModal() {
    closeModal(optionModalOverlay);
  }

  optionModalOverlay.addEventListener("click", (e) => {
    if (e.target === optionModalOverlay) closeOptionModal();
  });

  // Esc đóng dialog đang mở — hành vi dialog chuẩn, đặt chung cho cả 2.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (variantModalOverlay.classList.contains("show")) closeVariantModal();
    if (optionModalOverlay.classList.contains("show")) closeOptionModal();
  });

  optionForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = document.getElementById("optionId").value;
    const url = id
      ? `/shop/products/${PRODUCT_ID}/options/edit/${id}`
      : `/shop/products/${PRODUCT_ID}/options/add`;
    const submitBtn = document.getElementById("optionSubmitBtn");
    const originalLabel = submitBtn.innerText;
    submitBtn.disabled = true;
    submitBtn.innerText = "Đang lưu...";
    try {
      const result = await submitForm(url, optionForm);
      if (result.status === "success") {
        showToast(id ? "Cập nhật topping thành công!" : "Thêm topping thành công!", "success");
        closeOptionModal();
        setTimeout(() => window.location.reload(), 900);
      } else {
        showToast(result.msg || "Thất bại", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Lỗi", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = originalLabel;
    }
  });

  async function onDeleteOption(id) {
    if (!(await showConfirmDialog({ title: "Xoá topping", message: "Xóa topping này?", confirmText: "Xoá", danger: true }))) return;
    const response = await fetch(`/shop/products/${PRODUCT_ID}/options/delete/${id}`, { method: "POST" });
    const result = await response.json();
    if (result.status === "success") { showToast("Đã xóa!", "success"); setTimeout(() => window.location.reload(), 900); }
    else showToast(result.msg || "Thất bại", "error");
  }

</script>

<%- include('partials/footer') %>
