<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="header-bar">
    <div class="welcome-text">
      <h1>Quản lý mã giảm giá</h1>
      <p>Tạo mã voucher riêng cho cửa hàng của bạn</p>
    </div>
    <div class="header-bar-actions">
      <button type="button" class="btn-primary-action" onclick="openAddVoucherModal()">
        <i class="fa-solid fa-plus"></i>
        Thêm voucher
      </button>
    </div>
  </div>

  <div class="section-card">
    <div class="section-header">
      <h3>Danh sách mã giảm giá (<%= total %>)</h3>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr><th>Mã</th><th>Tên</th><th>Giảm giá</th><th>Đơn tối thiểu</th><th>Đã dùng</th><th>Thời gian</th><th>Trạng thái</th><th class="col-actions">Hành động</th></tr>
        </thead>
        <tbody id="vouchersTableBody">
          <% if (vouchers.length === 0) { %>
            <tr><td colspan="8">
              <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-ticket-simple"></i></div>
                <div class="empty-state-title">Chưa có mã giảm giá nào</div>
                <div class="empty-state-desc">Tạo voucher để khuyến khích khách hàng đặt đơn nhiều hơn.</div>
              </div>
            </td></tr>
          <% } %>
          <% vouchers.forEach(v => { %>
            <tr>
              <td><strong><%= v.voucher_code %></strong></td>
              <td><%= v.voucher_name %></td>
              <td>
                <% if (v.discount_type === 'percent') { %>Giảm <%= v.discount_value %>%
                <% } else if (v.discount_type === 'amount') { %>Giảm <%= v.discount_value.toLocaleString('vi-VN') %>đ
                <% } else { %>Miễn phí ship<% } %>
              </td>
              <td><%= v.min_order_amount.toLocaleString('vi-VN') %>đ</td>
              <td><%= v.used_count %>/<%= v.usage_limit || '∞' %></td>
              <td><%= new Date(v.start_date).toLocaleDateString('vi-VN') %> - <%= new Date(v.end_date).toLocaleDateString('vi-VN') %></td>
              <td><span class="status-badge <%= v.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= v.status %></span></td>
              <td class="col-actions">
                <div class="actions-wrap">
                  <button type="button" class="btn-action" onclick='onEditVoucher(<%= JSON.stringify(v) %>)'>Sửa</button>
                  <button type="button" class="btn-action btn-delete" onclick="onDeleteVoucher('<%= v._id %>')">Xóa</button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination', { page, totalPages, baseUrl: '/shop/vouchers' }) %>
  </div>
</div>

<!-- Dialog thêm/sửa voucher — dùng chung 1 form, đổi chế độ qua voucherEditId -->
<div class="product-modal-overlay" id="voucherModalOverlay">
  <div class="product-modal-card">
    <div class="product-modal-header">
      <h3 id="voucherModalTitle">Tạo mã giảm giá</h3>
      <button type="button" class="product-modal-close" onclick="closeVoucherModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form id="voucherForm">
      <div class="product-modal-body">
        <input type="hidden" id="voucherEditId">
        <div class="form-row">
          <div class="form-group"><label>Mã voucher *</label><input type="text" id="voucherCode" name="voucherCode" required placeholder="Ví dụ: TUHU50" style="text-transform:uppercase;"></div>
          <div class="form-group"><label>Tên chương trình *</label><input type="text" id="voucherName" name="voucherName" required placeholder="Ví dụ: Giảm 50k đơn từ 200k"></div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Loại giảm giá *</label>
            <select name="discountType" id="voucherDiscountType" required onchange="toggleDiscountValue()">
              <option value="percent">Giảm theo %</option>
              <option value="amount">Giảm theo số tiền</option>
              <option value="free_shipping">Miễn phí vận chuyển</option>
            </select>
          </div>
          <div class="form-group" id="voucherDiscountValueGroup"><label>Giá trị giảm *</label><input type="number" id="voucherDiscountValue" name="discountValue" min="0"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Đơn tối thiểu</label><input type="number" id="voucherMinOrderAmount" name="minOrderAmount" min="0" value="0"></div>
          <div class="form-group"><label>Giảm tối đa</label><input type="number" id="voucherMaxDiscountAmount" name="maxDiscountAmount" min="0" placeholder="Không giới hạn"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Giới hạn lượt lưu</label><input type="number" id="voucherClaimLimit" name="claimLimit" min="1" placeholder="Không giới hạn"></div>
          <div class="form-group"><label>Giới hạn lượt dùng</label><input type="number" id="voucherUsageLimit" name="usageLimit" min="1" placeholder="Không giới hạn"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Ngày bắt đầu *</label><input type="date" id="voucherStartDate" name="startDate" required></div>
          <div class="form-group"><label>Ngày kết thúc *</label><input type="date" id="voucherEndDate" name="endDate" required></div>
        </div>
        <div class="form-group" id="voucherStatusGroup" style="display:none;">
          <label>Trạng thái</label>
          <select id="voucherStatus" name="status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="expired">Expired</option></select>
        </div>
      </div>
      <div class="product-modal-footer">
        <button type="button" class="btn-cancel" onclick="closeVoucherModal()">Hủy</button>
        <button type="submit" class="btn-submit" id="voucherSubmitBtn">Tạo mã giảm giá</button>
      </div>
    </form>
  </div>
</div>

<script>
  const voucherModalOverlay = document.getElementById("voucherModalOverlay");
  const voucherForm = document.getElementById("voucherForm");
  const voucherEditIdInput = document.getElementById("voucherEditId");

  function toggleDiscountValue() {
    const type = document.getElementById("voucherDiscountType").value;
    document.getElementById("voucherDiscountValueGroup").style.display = type === "free_shipping" ? "none" : "block";
  }
  toggleDiscountValue();

  function openAddVoucherModal() {
    voucherForm.reset();
    voucherEditIdInput.value = "";
    document.getElementById("voucherModalTitle").innerText = "Tạo mã giảm giá";
    document.getElementById("voucherSubmitBtn").innerText = "Tạo mã giảm giá";
    document.getElementById("voucherStatusGroup").style.display = "none";
    toggleDiscountValue();
    voucherModalOverlay.classList.add("show");
    document.body.style.overflow = "hidden";
  }

  function onEditVoucher(v) {
    voucherForm.reset();
    voucherEditIdInput.value = v._id;
    document.getElementById("voucherCode").value = v.voucher_code;
    document.getElementById("voucherName").value = v.voucher_name;
    document.getElementById("voucherDiscountType").value = v.discount_type;
    document.getElementById("voucherDiscountValue").value = v.discount_value;
    document.getElementById("voucherMinOrderAmount").value = v.min_order_amount;
    document.getElementById("voucherMaxDiscountAmount").value = v.max_discount_amount || "";
    document.getElementById("voucherClaimLimit").value = v.claim_limit || "";
    document.getElementById("voucherUsageLimit").value = v.usage_limit || "";
    document.getElementById("voucherStartDate").value = v.start_date.slice(0, 10);
    document.getElementById("voucherEndDate").value = v.end_date.slice(0, 10);
    document.getElementById("voucherStatus").value = v.status;
    document.getElementById("voucherModalTitle").innerText = "Sửa mã giảm giá";
    document.getElementById("voucherSubmitBtn").innerText = "Lưu thay đổi";
    document.getElementById("voucherStatusGroup").style.display = "block";
    toggleDiscountValue();
    voucherModalOverlay.classList.add("show");
    document.body.style.overflow = "hidden";
  }

  function closeVoucherModal() {
    voucherModalOverlay.classList.remove("show");
    document.body.style.overflow = "";
  }

  // Đóng dialog khi bấm ra ngoài card hoặc nhấn Esc — hành vi dialog chuẩn.
  voucherModalOverlay.addEventListener("click", (e) => {
    if (e.target === voucherModalOverlay) closeVoucherModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && voucherModalOverlay.classList.contains("show")) closeVoucherModal();
  });

  voucherForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const editId = voucherEditIdInput.value;
    const formData = new FormData(voucherForm);
    const body = Object.fromEntries(formData.entries());

    const submitBtn = document.getElementById("voucherSubmitBtn");
    submitBtn.disabled = true;
    submitBtn.innerText = "Đang lưu...";

    try {
      const url = editId ? `/shop/vouchers/edit/${editId}` : "/shop/vouchers/add";
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (result.status === "success") {
        showToast(editId ? "Cập nhật thành công!" : "Tạo mã giảm giá thành công!", "success");
        closeVoucherModal();
        setTimeout(() => window.location.reload(), 900);
      } else {
        showToast(result.msg || "Thất bại", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Lỗi", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = editId ? "Lưu thay đổi" : "Tạo mã giảm giá";
    }
  });

  async function onDeleteVoucher(id) {
    if (!(await showConfirmDialog({ title: "Xoá voucher", message: "Xóa mã giảm giá này?", confirmText: "Xoá", danger: true }))) return;
    const response = await fetch(`/shop/vouchers/delete/${id}`, { method: "POST" });
    const result = await response.json();
    if (result.status === "success") { showToast("Đã xóa!", "success"); setTimeout(() => window.location.reload(), 900); }
    else showToast(result.msg || "Thất bại", "error");
  }
</script>

<%- include('partials/footer') %>
