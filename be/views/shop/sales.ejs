<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="header-bar">
    <div class="welcome-text">
      <h1>Quản lý khuyến mãi</h1>
      <p>Tạo chương trình giảm giá theo sản phẩm hoặc biến thể trong khoảng thời gian</p>
    </div>
  </div>

  <div class="content-grid">
    <div class="section-card">
      <div class="section-header">
        <h3>Danh sách chương trình (<%= sales.length %>)</h3>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Chương trình</th><th>Sản phẩm</th><th>Biến thể</th><th>Giá KM</th><th>Thời gian</th><th>Đã bán/Giới hạn</th><th>Trạng thái</th><th class="col-actions">Hành động</th></tr>
          </thead>
          <tbody id="salesTableBody">
            <% sales.forEach(s => { %>
              <tr>
                <td><strong><%= s.sale_name %></strong></td>
                <td><%= s.product_id ? s.product_id.product_name : 'N/A' %></td>
                <td><%= s.variant_id ? s.variant_id.variant_name : 'Tất cả biến thể' %></td>
                <td><%= s.sale_price.toLocaleString('vi-VN') %>đ</td>
                <td><%= new Date(s.start_date).toLocaleDateString('vi-VN') %> - <%= new Date(s.end_date).toLocaleDateString('vi-VN') %></td>
                <td><%= s.sold_quantity %>/<%= s.sale_limit || '∞' %></td>
                <td><span class="status-badge <%= s.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= s.status %></span></td>
                <td class="col-actions">
                  <div class="actions-wrap">
                    <button type="button" class="btn-action" onclick='onEditSale(<%- JSON.stringify({ _id: s._id, sale_name: s.sale_name, sale_price: s.sale_price, sale_limit: s.sale_limit, start_date: s.start_date, end_date: s.end_date, status: s.status }) %>)'>Sửa</button>
                    <button type="button" class="btn-action btn-delete" onclick="onDeleteSale('<%= s._id %>')">Xóa</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <div class="section-card" id="saleAddCard" style="margin-bottom: 24px;">
        <div class="section-header"><h3>Tạo chương trình khuyến mãi</h3></div>
        <form id="addSaleForm">
          <div class="form-group">
            <label>Sản phẩm *</label>
            <select id="addSaleProduct" name="productId" required onchange="populateVariantOptions('addSaleProduct', 'addSaleVariant')">
              <% products.forEach(p => { %><option value="<%= p._id %>"><%= p.product_name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Biến thể</label>
            <select id="addSaleVariant" name="variantId">
              <option value="">Tất cả biến thể</option>
            </select>
          </div>
          <div class="form-group"><label>Tên chương trình *</label><input type="text" name="saleName" required placeholder="Ví dụ: Giảm giá cuối tuần"></div>
          <div class="form-group"><label>Giá khuyến mãi *</label><input type="number" name="salePrice" required min="0"></div>
          <div class="form-group"><label>Giới hạn số lượng</label><input type="number" name="saleLimit" min="1" placeholder="Để trống nếu không giới hạn"></div>
          <div class="form-group"><label>Ngày bắt đầu *</label><input type="date" name="startDate" required></div>
          <div class="form-group"><label>Ngày kết thúc *</label><input type="date" name="endDate" required></div>
          <button type="submit" class="btn-submit">Tạo chương trình</button>
        </form>
      </div>

      <div class="section-card" id="saleEditCard" style="display:none;">
        <div class="section-header"><h3>Sửa chương trình</h3></div>
        <form id="editSaleForm">
          <input type="hidden" id="editSaleId">
          <div class="form-group"><label>Tên chương trình *</label><input type="text" id="editSaleName" name="saleName" required></div>
          <div class="form-group"><label>Giá khuyến mãi *</label><input type="number" id="editSalePrice" name="salePrice" required min="0"></div>
          <div class="form-group"><label>Giới hạn số lượng</label><input type="number" id="editSaleLimit" name="saleLimit" min="1"></div>
          <div class="form-group"><label>Ngày bắt đầu *</label><input type="date" id="editSaleStartDate" name="startDate" required></div>
          <div class="form-group"><label>Ngày kết thúc *</label><input type="date" id="editSaleEndDate" name="endDate" required></div>
          <div class="form-group"><label>Trạng thái</label>
            <select id="editSaleStatus" name="status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="expired">Expired</option></select>
          </div>
          <button type="submit" class="btn-submit">Lưu</button>
          <button type="button" class="btn-cancel" onclick="cancelSaleEdit()">Hủy</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const variantsByProduct = <%- JSON.stringify(variantsByProduct) %>;

  function populateVariantOptions(productSelectId, variantSelectId) {
    const productId = document.getElementById(productSelectId).value;
    const variantSelect = document.getElementById(variantSelectId);
    const variants = variantsByProduct[productId] || [];

    variantSelect.innerHTML = '<option value="">Tất cả biến thể</option>' +
      variants.map(v => `<option value="${v._id}">${v.variant_name}</option>`).join('');
  }

  // Initialize variant dropdown for the first product on load
  populateVariantOptions('addSaleProduct', 'addSaleVariant');

  document.getElementById("addSaleForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    try {
      const response = await fetch("/shop/sales/add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (result.status === "success") { alert("Tạo chương trình thành công!"); window.location.reload(); }
      else alert(result.msg || "Thất bại");
    } catch (err) { console.error(err); alert("Lỗi"); }
  });

  function onEditSale(s) {
    document.getElementById("saleAddCard").style.display = "none";
    document.getElementById("saleEditCard").style.display = "block";
    document.getElementById("editSaleId").value = s._id;
    document.getElementById("editSaleName").value = s.sale_name;
    document.getElementById("editSalePrice").value = s.sale_price;
    document.getElementById("editSaleLimit").value = s.sale_limit || "";
    document.getElementById("editSaleStartDate").value = s.start_date.slice(0, 10);
    document.getElementById("editSaleEndDate").value = s.end_date.slice(0, 10);
    document.getElementById("editSaleStatus").value = s.status;
  }

  function cancelSaleEdit() {
    document.getElementById("saleEditCard").style.display = "none";
    document.getElementById("saleAddCard").style.display = "block";
  }

  document.getElementById("editSaleForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = document.getElementById("editSaleId").value;
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    try {
      const response = await fetch(`/shop/sales/edit/${id}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (result.status === "success") { alert("Cập nhật thành công!"); window.location.reload(); }
      else alert(result.msg || "Thất bại");
    } catch (err) { console.error(err); alert("Lỗi"); }
  });

  async function onDeleteSale(id) {
    if (!confirm("Xóa chương trình khuyến mãi này?")) return;
    const response = await fetch(`/shop/sales/delete/${id}`, { method: "POST" });
    const result = await response.json();
    if (result.status === "success") { alert("Đã xóa!"); window.location.reload(); }
    else alert(result.msg || "Thất bại");
  }
</script>

<%- include('partials/footer') %>
