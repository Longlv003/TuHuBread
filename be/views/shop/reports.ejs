<%- include('partials/header') %>

<!-- Sidebar Navigation -->
<%- include('partials/sidebar') %>

<!-- Main Content Area -->
<div class="main-content">
  <div class="header-bar">
    <div class="welcome-text">
      <h1>Báo cáo doanh thu</h1>
      <p>Theo dõi doanh thu và sản phẩm bán chạy theo thời gian</p>
    </div>
    <form method="GET" action="/shop/reports" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <select name="days" onchange="this.form.from.value=''; this.form.to.value=''; this.form.submit()">
        <option value="7" <%= (days === 7 && !from) ? 'selected' : '' %>>7 ngày qua</option>
        <option value="30" <%= (days === 30 && !from) ? 'selected' : '' %>>30 ngày qua</option>
        <option value="90" <%= (days === 90 && !from) ? 'selected' : '' %>>90 ngày qua</option>
      </select>
      <input type="date" name="from" value="<%= from %>">
      <span>-</span>
      <input type="date" name="to" value="<%= to %>">
      <button type="submit" class="btn-action">Lọc theo ngày</button>
    </form>
  </div>

  <%
    // Hàm dựng dòng "so với kỳ trước". Trả về null nghĩa là kỳ trước không có
    // dữ liệu -> không so sánh được, hiện chữ trung tính thay vì +100%.
    const trendHtml = (percent) => {
      if (percent === null || percent === undefined) {
        return '<span class="kpi-trend neutral">Chưa có dữ liệu kỳ trước</span>';
      }
      const up = percent >= 0;
      const icon = up ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down';
      const cls = up ? 'up' : 'down';
      return `<span class="kpi-trend ${cls}"><i class="fa-solid ${icon}"></i> ${up ? '+' : ''}${percent}% so với kỳ trước</span>`;
    };
  %>

  <div class="kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin-bottom: 30px;">
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Tổng doanh thu</h4>
        <h2><%= Math.round(report.summary.totalRevenue).toLocaleString('vi-VN') %>đ</h2>
        <%- trendHtml(report.summary.revenueChangePercent) %>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-sack-dollar"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Đơn hoàn thành</h4>
        <h2><%= report.summary.totalOrders %></h2>
        <%- trendHtml(report.summary.ordersChangePercent) %>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-clipboard-check"></i></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-info">
        <h4>Tỷ lệ huỷ đơn</h4>
        <h2><%= report.summary.cancelRate %>%</h2>
        <span class="kpi-trend neutral"><%= report.summary.cancelledOrders %> đơn bị huỷ</span>
      </div>
      <div class="kpi-icon"><i class="fa-solid fa-circle-xmark"></i></div>
    </div>
  </div>

  <div class="section-card" style="margin-bottom: 24px;">
    <div class="section-header"><h3>Doanh thu theo ngày</h3></div>
    <div class="chart-container">
      <canvas id="revenueChart"></canvas>
    </div>
  </div>

  <div class="section-card" style="margin: 24px 0;">
    <div class="section-header"><h3>Đơn hàng theo trạng thái</h3></div>
    <div class="status-stat-grid">
      <%
        const statusLabels = {
          pending: ['Chờ xác nhận', 'fa-hourglass-half', '#F1C40F'],
          confirmed: ['Đã xác nhận', 'fa-circle-check', '#2980B9'],
          preparing: ['Đang chuẩn bị', 'fa-utensils', '#E67E22'],
          delivering: ['Đang giao', 'fa-truck-fast', '#8E44AD'],
          completed: ['Hoàn thành', 'fa-flag-checkered', '#27AE60'],
          cancelled: ['Đã huỷ', 'fa-circle-xmark', '#E74C3C'],
        };
      %>
      <% Object.entries(statusLabels).forEach(([key, [label, icon, color]]) => { %>
        <div class="status-stat">
          <i class="fa-solid <%= icon %>" style="color: <%= color %>;"></i>
          <div>
            <div class="status-stat-value"><%= report.statusCounts[key] || 0 %></div>
            <div class="status-stat-label"><%= label %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="section-card">
    <div class="section-header"><h3>Top sản phẩm bán chạy</h3></div>
    <div class="table-container">
      <table>
        <thead><tr><th>#</th><th>Sản phẩm</th><th class="col-center">Số lượng bán</th><th>Doanh thu</th></tr></thead>
        <tbody>
          <% report.topProducts.forEach((p, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><strong><%= p.product_name %></strong></td>
              <td class="col-center"><%= p.quantity_sold %></td>
              <td><%= p.revenue.toLocaleString('vi-VN') %>đ</td>
            </tr>
          <% }) %>
          <% if (report.topProducts.length === 0) { %>
            <tr><td colspan="4" style="text-align:center; color:var(--text-muted);">Chưa có dữ liệu bán hàng trong khoảng thời gian này</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  const dailyRevenue = <%- JSON.stringify(report.dailyRevenue) %>;

  const ctx = document.getElementById("revenueChart").getContext("2d");
  new Chart(ctx, {
    type: "line",
    data: {
      labels: dailyRevenue.map(d => d.date.slice(5)),
      datasets: [{
        label: "Doanh thu (đ)",
        data: dailyRevenue.map(d => d.revenue),
        borderColor: "#E67E22",
        backgroundColor: "rgba(230, 126, 34, 0.15)",
        fill: true,
        tension: 0.3,
        pointRadius: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { labels: { color: "#2C3E50" } } },
      scales: {
        x: { ticks: { color: "#7F8C8D" }, grid: { color: "rgba(44,62,80,0.06)" } },
        y: { ticks: { color: "#7F8C8D" }, grid: { color: "rgba(44,62,80,0.06)" } }
      }
    }
  });
</script>

<%- include('partials/footer') %>
