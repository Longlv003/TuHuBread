<%
  // Mỗi thẻ chỉ hiện khi thực sự có việc cần làm — cảnh báo lúc nào cũng sáng
  // đèn thì chủ shop sẽ quen mắt và bỏ qua luôn cả lúc có chuyện thật.
  const hasUnpaid = alerts.unpaidOrders > 0;
  const hasPending = alerts.pendingOrders > 0;
  const hasAny = hasUnpaid || hasPending;
%>

<% if (!hasAny) { %>
  <div class="alert-card alert-ok">
    <div class="alert-card-icon"><i class="fa-solid fa-circle-check"></i></div>
    <div class="alert-card-body">
      <div class="alert-card-title">Không có cảnh báo nào</div>
      <div class="alert-card-desc">Đơn hàng đã xử lý hết.</div>
    </div>
  </div>
<% } %>

<% if (hasPending) { %>
  <a href="/shop/orders?status=pending" class="alert-card alert-warning">
    <div class="alert-card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
    <div class="alert-card-body">
      <div class="alert-card-title"><%= alerts.pendingOrders %> đơn đang chờ xử lý</div>
      <div class="alert-card-desc">Xác nhận sớm để khách không phải chờ lâu.</div>
    </div>
    <i class="fa-solid fa-chevron-right alert-card-arrow"></i>
  </a>
<% } %>

<% if (hasUnpaid) { %>
  <a href="/shop/orders" class="alert-card alert-info">
    <div class="alert-card-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
    <div class="alert-card-body">
      <div class="alert-card-title"><%= alerts.unpaidOrders %> đơn chưa thanh toán</div>
      <div class="alert-card-desc">Đơn tiền mặt sẽ tự chuyển sang đã thanh toán khi hoàn thành.</div>
    </div>
    <i class="fa-solid fa-chevron-right alert-card-arrow"></i>
  </a>
<% } %>
