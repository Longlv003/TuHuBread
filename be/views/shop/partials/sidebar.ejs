<div class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-container" onclick="document.getElementById('logoUploadInput').click()">
      <img id="shopLogoImg" src="<%= shop.logo ? shop.logo : 'https://placehold.co/100' %>" alt="Shop logo" onerror="this.src='https://placehold.co/100'">
      <div class="logo-overlay">
        <i class="fa-solid fa-camera"></i>
      </div>
    </div>
    <input type="file" id="logoUploadInput" accept="image/*" style="display:none">
    <h3><%= shop.shop_name %></h3>
  </div>
  <ul class="nav-menu">
    <li class="nav-item <%= activeTab === 'dashboard' ? 'active' : '' %>">
      <a href="/shop/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
    </li>
    <li class="nav-item <%= activeTab === 'reports' ? 'active' : '' %>">
      <a href="/shop/reports"><i class="fa-solid fa-chart-pie"></i> Báo cáo doanh thu</a>
    </li>
    <li class="nav-item <%= activeTab === 'orders' ? 'active' : '' %>">
      <a href="/shop/orders"><i class="fa-solid fa-receipt"></i> Đơn hàng</a>
    </li>
    <li class="nav-item <%= activeTab === 'products' ? 'active' : '' %>">
      <a href="/shop/products"><i class="fa-solid fa-burger"></i> Sản phẩm</a>
    </li>
    <li class="nav-item <%= activeTab === 'sales' ? 'active' : '' %>">
      <a href="/shop/sales"><i class="fa-solid fa-percent"></i> Khuyến mãi</a>
    </li>
    <li class="nav-item <%= activeTab === 'vouchers' ? 'active' : '' %>">
      <a href="/shop/vouchers"><i class="fa-solid fa-ticket-simple"></i> Mã giảm giá</a>
    </li>
    <li class="nav-item <%= activeTab === 'reviews' ? 'active' : '' %>">
      <a href="/shop/reviews"><i class="fa-solid fa-star-half-stroke"></i> Đánh giá (Reviews)</a>
    </li>
    <li class="nav-item <%= activeTab === 'notifications' ? 'active' : '' %>">
      <a href="/shop/notifications"><i class="fa-solid fa-bell"></i> Thông báo</a>
    </li>
    <li class="nav-item <%= activeTab === 'settings' ? 'active' : '' %>">
      <a href="/shop/settings"><i class="fa-solid fa-gear"></i> Cài đặt cửa hàng</a>
    </li>
  </ul>
  <a href="/shop/logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a>
</div>
